    "# ============================================================\n",
    "# CELDA 1 — Imports, configuración y rutas verificadas\n",
    "# 01_eda.ipynb · AmazonNet\n",
    "# Entorno: Kaggle Notebook (mirror dataset nikitarom)\n",
    "# ============================================================\n",
    "\n",
    "from pathlib import Path\n",
    "from collections import Counter\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import matplotlib.patches as mpatches\n",
    "import seaborn as sns\n",
    "from PIL import Image\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "# ── Estilo global ────────────────────────────────────────────\n",
    "plt.rcParams[\"figure.dpi\"]       = 120\n",
    "plt.rcParams[\"font.size\"]        = 11\n",
    "plt.rcParams[\"axes.titlesize\"]   = 13\n",
    "plt.rcParams[\"axes.titleweight\"] = \"bold\"\n",
    "sns.set_style(\"whitegrid\")\n",
    "\n",
    "# ── Rutas verificadas ─────────────────────────────────────────\n",
    "PLANET_DIR = Path(\"/kaggle/input/datasets/nikitarom/planets-dataset/planet/planet\")\n",
    "TRAIN_DIR  = PLANET_DIR / \"train-jpg\"\n",
    "TEST_DIR   = PLANET_DIR / \"test-jpg\"\n",
    "CSV_TRAIN  = PLANET_DIR / \"train_classes.csv\"\n",
    "\n",
    "# ── Verificación ──────────────────────────────────────────────\n",
    "print(\"=== Verificación de rutas ===\")\n",
    "print(f\"  CSV de train : {'✅ encontrado' if CSV_TRAIN.exists() else '❌ no encontrado'}\")\n",
    "print(f\"  Train images : {len(list(TRAIN_DIR.glob('*.jpg'))):>7,}\")\n",
    "print(f\"  Test images  : {len(list(TEST_DIR.glob('*.jpg'))):>7,}\")\n",
    "\n",
    "# ── Metadatos de imagen ───────────────────────────────────────\n",
    "# Abrimos DOS imágenes para ver si el modo CMYK es consistente\n",
    "# o solo aparece en algunas — eso cambia la estrategia de carga\n",
    "\n",
    "print(\"\\n=== Metadatos de muestra (3 imágenes aleatorias) ===\")\n",
    "sample_paths = list(TRAIN_DIR.glob(\"*.jpg\"))[:3]\n",
    "\n",
    "for p in sample_paths:\n",
    "    img = Image.open(p)\n",
    "    print(f\"  {p.name:<20}  tamaño: {img.size}   modo: {img.mode}\")\n",
    "\n",
    "# ── Conclusión del modo ───────────────────────────────────────\n",
    "# Independientemente del resultado anterior, SIEMPRE convertiremos\n",
    "# a RGB al cargar cualquier imagen en este proyecto.\n",
    "# Motivo: las arquitecturas preentrenadas (EfficientNet, ResNet)\n",
    "# esperan tensores [batch, 3, H, W]. CMYK tiene 4 canales y\n",
    "# rompería la primera capa convolucional.\n",
    "# PIL maneja .convert(\"RGB\") de forma transparente y sin coste.\n",
    "\n",
    "print(\"\\n✅ Todas las imágenes se cargarán con .convert('RGB') en adelante\")\n",
    "print(f\"   → Resolución confirmada: 256×256 px\")\n",
    "print(f\"   → Canales tras conversión: 3 (R, G, B)\")"
   ]
