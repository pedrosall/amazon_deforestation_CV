    "# cooc_normalized[i,j] = cooc_raw[i,j] / min(freq[i], freq[j])\n",
    "# Si etiqueta i tiene 100 imágenes y co-ocurre con j en 90 → 0.9\n",
    "cooc_norm = np.zeros((17, 17))\n",
    "for i in range(17):\n",
    "    for j in range(17):\n",
