    "# ============================================================\n",
    "# CELDA 6 — Visualización de imágenes reales con etiquetas\n",
    "# 01_eda.ipynb · AmazonNet\n",
    "# ============================================================\n",
    "\n",
    "# ── Estrategia de visualización ───────────────────────────────\n",
    "# No mostramos imágenes aleatorias. Mostramos imágenes\n",
    "# representativas de cada CATEGORÍA de etiqueta para que\n",
    "# puedas ver visualmente qué distingue cada clase.\n",
    "#\n",
    "# Organizamos en 4 bloques:\n",
    "#   A) Condiciones atmosféricas (clear, cloudy, haze, partly_cloudy)\n",
    "#   B) Cobertura base (primary sola, sin amenazas)\n",
    "#   C) Uso del suelo (agriculture, cultivation, habitation, road, water)\n",
    "#   D) Amenazas (selective_logging, slash_burn, artisinal_mine,\n",
    "#                blow_down, conventional_mine, bare_ground, blooming)\n",
    "\n",
    "def load_rgb(image_name):\n",
    "    \"\"\"Carga una imagen y la convierte siempre a RGB (maneja CMYK).\"\"\"\n",
    "    path = TRAIN_DIR / f\"{image_name}.jpg\"\n",
    "    return Image.open(path).convert(\"RGB\")\n",
    "\n",
    "def get_sample_for_label(label, n=1, exclude_labels=None):\n",
    "    \"\"\"\n",
    "    Devuelve n imágenes que tienen 'label' activa.\n",
    "    Si exclude_labels es una lista, filtra imágenes que también\n",
    "    tengan esas etiquetas (para aislar visualmente una clase).\n",
    "    \"\"\"\n",
    "    mask = label_df[label] == 1\n",
    "    if exclude_labels:\n",
    "        for exc in exclude_labels:\n",
    "            mask = mask & (label_df[exc] == 0)\n",
    "    subset = label_df[mask]\n",
    "    if len(subset) == 0:\n",
    "        subset = label_df[label_df[label] == 1]  # fallback sin filtro\n",
    "    sample = subset.sample(n=min(n, len(subset)), random_state=42)\n",
    "    return sample[\"image_name\"].tolist()\n",
    "\n",
    "def plot_image_grid(title, image_label_pairs, cols=4, figsize=(16, None)):\n",
    "    \"\"\"\n",
    "    Dibuja un grid de imágenes con sus etiquetas.\n",
    "    image_label_pairs: lista de (image_name, [lista de etiquetas activas])\n",
    "    \"\"\"\n",
    "    rows = (len(image_label_pairs) + cols - 1) // cols\n",
    "    height = figsize[1] or rows * 3.5\n",
    "    \n",
    "    fig, axes = plt.subplots(rows, cols, figsize=(figsize[0], height))\n",
    "    axes = axes.flatten() if rows > 1 or cols > 1 else [axes]\n",
    "    fig.suptitle(title, fontsize=13, fontweight=\"bold\", y=1.01)\n",
    "    \n",
    "    for idx, (img_name, active_labels) in enumerate(image_label_pairs):\n",
    "        ax = axes[idx]\n",
    "        img = load_rgb(img_name)\n",
    "        ax.imshow(img)\n",
    "        ax.set_title(\n",
    "            \"\\n\".join(active_labels),   # etiquetas activas en el título\n",
    "            fontsize=7.5,\n",
    "            color=\"#1a1a2e\",\n",
    "            pad=4\n",
    "        )\n",
    "        ax.axis(\"off\")\n",
    "        # Borde de color según categoría dominante\n",
    "        for spine in ax.spines.values():\n",
    "            spine.set_visible(True)\n",
    "            spine.set_linewidth(2.5)\n",
    "    \n",
    "    # Ocultar ejes sobrantes si las imágenes no llenan el grid\n",
    "    for idx in range(len(image_label_pairs), len(axes)):\n",
    "        axes[idx].axis(\"off\")\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "# ── Bloque A: Condiciones atmosféricas ────────────────────────\n",
    "print(\"Generando Bloque A: Condiciones atmosféricas...\")\n",
    "\n",
    "atm_samples = []\n",
    "for label, color in [(\"clear\", \"#4A90D9\"), (\"cloudy\", \"#A0B8D0\"),\n",
    "                      (\"haze\", \"#B0C4DE\"), (\"partly_cloudy\", \"#7BAFD4\")]:\n",
    "    names = get_sample_for_label(label, n=2)\n",
    "    for name in names:\n",
    "        active = label_df[label_df[\"image_name\"] == name]\\\n",
    "                     .drop(columns=\"image_name\")\\\n",
    "                     .iloc[0]\n",
    "        active_labels = [l for l in ALL_LABELS if active[l] == 1]\n",
    "        atm_samples.append((name, active_labels))\n",
    "\n",
    "fig_a = plot_image_grid(\"Bloque A — Condiciones atmosféricas\", \n",
    "                         atm_samples, cols=4)\n",
