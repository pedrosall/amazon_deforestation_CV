    "# CELDA 5 — Heatmap de co-ocurrencia entre etiquetas\n",
    "# 01_eda.ipynb · AmazonNet\n",
    "# ============================================================\n",
    "\n",
    "# ── ¿Qué es la co-ocurrencia? ─────────────────────────────────\n",
    "# La co-ocurrencia entre etiqueta A y etiqueta B es el número\n",
    "# de imágenes donde AMBAS están presentes simultáneamente.\n",
    "# \n",
    "# Matemáticamente es el producto matricial:\n",
    "#     label_matrix.T @ label_matrix\n",
    "# \n",
    "# Cada celda (i,j) del resultado = dot product de la columna i\n",
    "# con la columna j = número de imágenes donde ambas son 1.\n",
    "# La diagonal (i,i) = número de imágenes donde la etiqueta i\n",
    "# aparece sola (es decir, su frecuencia total).\n",
    "#\n",
    "# ¿Por qué no correlación de Pearson?\n",
    "# Pearson mide correlación lineal, que para variables binarias\n",
    "# está influenciada por las frecuencias marginales.\n",
    "# Una etiqueta rarísima nunca alcanzará Pearson alto aunque\n",
    "# co-ocurra perfectamente con otra. Para visualizar la estructura\n",
    "# real usamos co-ocurrencia normalizada (entre 0 y 1).\n",
    "\n",
    "# ── Paso 1: matriz de co-ocurrencia bruta ─────────────────────\n",
    "binary_matrix = label_df.drop(columns=\"image_name\").values.astype(float)\n",
    "# Shape: (40479, 17)\n",
    "\n",
    "# Producto matricial: (17, 40479) @ (40479, 17) = (17, 17)\n",
    "cooc_raw = binary_matrix.T @ binary_matrix\n",
    "# cooc_raw[i,j] = imágenes donde etiqueta i y etiqueta j coinciden\n",
    "\n",
    "# ── Paso 2: normalización ─────────────────────────────────────\n",
    "# Normalizamos dividiendo por la frecuencia de la etiqueta menos\n",
    "# frecuente de cada par. Esto convierte los conteos brutos en:\n",
    "# \"de las imágenes que tienen etiqueta A, ¿qué fracción también\n",
    "#  tiene etiqueta B?\"\n",
    "# \n",
    "# Técnicamente es el Índice de Jaccard:\n",
    "#     J(A,B) = |A ∩ B| / |A ∪ B|\n",
    "# Es la métrica estándar para similitud entre conjuntos binarios.\n",
    "# Vale 1 si las etiquetas siempre van juntas, 0 si nunca.\n",
    "\n",
    "from sklearn.metrics import pairwise_distances\n",
    "\n",
    "# Forma más directa: normalizar por el mínimo de frecuencias\n",
    "freq_array = binary_matrix.sum(axis=0)  # frecuencia de cada etiqueta (17,)\n",
