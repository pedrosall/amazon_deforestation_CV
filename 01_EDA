    "# ============================================================\n",
    "# CELDA 2 — Carga del CSV y binarización de etiquetas\n",
    "# 01_eda.ipynb · AmazonNet\n",
    "# ============================================================\n",
    "\n",
    "# ── Cargar el CSV ─────────────────────────────────────────────\n",
    "df = pd.read_csv(CSV_TRAIN)\n",
    "\n",
    "print(\"=== CSV cargado ===\")\n",
    "print(f\"  Forma         : {df.shape}  (filas × columnas)\")\n",
    "print(f\"  Columnas      : {df.columns.tolist()}\")\n",
    "print(f\"  Nulos         : {df.isnull().sum().sum()}\")\n",
    "print()\n",
    "print(df.head(5).to_string(index=False))\n",
    "\n",
    "# ── Parsear etiquetas ──────────────────────────────────────────\n",
    "# La columna 'tags' contiene strings separados por espacios.\n",
    "# Primero las convertimos a listas de strings:\n",
    "#   \"agriculture clear primary\" → [\"agriculture\", \"clear\", \"primary\"]\n",
    "\n",
    "df[\"tag_list\"] = df[\"tags\"].str.split()\n",
    "\n",
    "# ── Construir la lista de etiquetas únicas (ordenadas) ────────\n",
    "# Usamos Counter para contar cuántas veces aparece cada etiqueta\n",
    "# (lo usaremos en la Celda 3 para la visualización).\n",
    "# El orden importa: siempre usaremos ALL_LABELS como referencia\n",
    "# para que el vector binario tenga siempre las mismas posiciones.\n",
    "\n",
    "label_counts = Counter(tag for tags in df[\"tag_list\"] for tag in tags)\n",
    "ALL_LABELS   = sorted(label_counts.keys())   # orden alfabético → reproducible\n",
    "\n",
    "print(f\"\\n=== Etiquetas únicas encontradas: {len(ALL_LABELS)} ===\")\n",
    "print(f\"  {ALL_LABELS}\")\n",
    "\n",
    "# ── Construir la matriz binaria con MultiLabelBinarizer ────────\n",
    "# sklearn tiene una clase diseñada exactamente para esto.\n",
    "# Toma una lista de listas y devuelve una matriz 0/1.\n",
    "#\n",
    "# Alternativas que NO usamos y por qué:\n",
    "#   - pd.get_dummies(df[\"tags\"]) → trata cada string completo como categoría,\n",
    "#     no las etiquetas individuales. No funciona para multi-etiqueta.\n",
    "#   - Bucle manual → funciona, pero es lento y verbose innecesariamente.\n",
    "\n",
    "from sklearn.preprocessing import MultiLabelBinarizer\n",
    "\n",
    "mlb = MultiLabelBinarizer(classes=ALL_LABELS)  \n",
    "# Pasamos ALL_LABELS explícitamente → garantiza orden fijo en las columnas\n",
    "\n",
    "label_matrix = mlb.fit_transform(df[\"tag_list\"])\n",
    "# Resultado: array NumPy de forma (40479, 17)\n",
    "# Fila i → vector binario de la imagen i\n",
    "# Columna j → etiqueta ALL_LABELS[j] presente (1) o no (0)\n",
    "\n",
    "# ── Construir DataFrame de etiquetas ──────────────────────────\n",
    "# Unimos el nombre de imagen con la matriz binaria en un solo DataFrame.\n",
    "# Esto nos da una tabla limpia y consultable para el resto del EDA.\n",
    "\n",
    "label_df = pd.DataFrame(label_matrix, columns=ALL_LABELS)\n",
    "label_df.insert(0, \"image_name\", df[\"image_name\"])\n",
    "\n",
    "print(f\"\\n=== Matriz binaria construida ===\")\n",
    "print(f\"  Forma : {label_matrix.shape}  (imágenes × etiquetas)\")\n",
    "print(f\"\\nPrimeras 5 filas de label_df:\")\n",
    "print(label_df.head(5).to_string(index=False))\n",
    "\n",
    "# ── Verificación de integridad ─────────────────────────────────\n",
    "# Comprobamos que ninguna imagen tiene 0 etiquetas\n",
    "# (eso sería una fila de ceros, un dato corrupto)\n",
    "\n",
    "etiquetas_por_imagen = label_matrix.sum(axis=1)   # suma por fila\n",
    "imagenes_sin_etiqueta = (etiquetas_por_imagen == 0).sum()\n",
    "\n",
    "print(f\"\\n=== Verificación de integridad ===\")\n",
    "print(f\"  Imágenes sin ninguna etiqueta  : {imagenes_sin_etiqueta}  (esperado: 0)\")\n",
    "print(f\"  Media de etiquetas por imagen  : {etiquetas_por_imagen.mean():.2f}\")\n",
    "print(f\"  Mínimo de etiquetas            : {etiquetas_por_imagen.min()}\")\n",
    "print(f\"  Máximo de etiquetas            : {etiquetas_por_imagen.max()}\")"
